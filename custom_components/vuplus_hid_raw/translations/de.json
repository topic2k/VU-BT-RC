      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Auch die Kopplung löschen oder nur Gerät/Integration?",
            "description": "Der Integrationseintrag ist bereits gelöscht. Die Bluetooth-Kopplung besteht weiterhin.\n\nFernbedienung: {address}\n\nAdapter: {adapter}\n\nWähle „Auch die Bluetooth-Kopplung löschen“ und bestätige, um die Verbindung, Kopplung und das Vertrauen auf dem HA-Host zu entfernen. Für eine erneute Nutzung musst du die Fernbedienung wieder koppeln. Mit „Nur Gerät/Integration löschen“ bleibt die Kopplung erhalten und die Rückfrage wird geschlossen. Ein Gedankenstrich (—) bedeutet, dass die Adresse nicht eindeutig ermittelt werden konnte.",
            "data": {
              "action": "Was möchtest du löschen?"
            }
          }
        },
        "progress": {
          "unpair": "Die bestätigte Bluetooth-Kopplung wird entfernt …"
        },
        "error": {
          "bluetooth_identity_missing": "Die Bluetooth-Kopplung ist nicht eindeutig bekannt. Es wurde nichts entfernt. Behalte die Kopplung oder entferne sie bei Bedarf manuell mit bluetoothctl auf dem richtigen Adapter.",
          "bluetooth_still_in_use": "Die Fernbedienung wird inzwischen von einem anderen oder neu angelegten Integrationseintrag verwendet. Die Kopplung wird deshalb beibehalten.",
          "bluetooth_no_adapter": "Der ursprüngliche lokale Bluetooth-Adapter ist nicht verfügbar. Verbinde ihn erneut und bestätige einen neuen Versuch, oder behalte die Kopplung.",
          "bluetooth_permission": "Home Assistant hat keine Berechtigung zum Entkoppeln. Prüfe die D-Bus-Berechtigungen oder behalte die Kopplung.",
          "bluetooth_timeout": "Zeitüberschreitung: Das Entkoppeln konnte nicht bestätigt werden. Prüfe Bluetooth und bestätige bei Bedarf einen neuen Versuch.",
          "bluetooth_unavailable": "BlueZ oder der System-D-Bus ist nicht erreichbar. Prüfe Bluetooth auf dem HA-Host oder behalte die Kopplung.",
          "bluetooth_adapter_off": "Der Bluetooth-Adapter ist nicht bereit. Prüfe den Adapter oder behalte die Kopplung.",
          "bluetooth_failed": "Das Entkoppeln konnte nicht bestätigt werden. Prüfe Bluetooth auf dem HA-Host und bestätige bei Bedarf einen neuen Versuch."
