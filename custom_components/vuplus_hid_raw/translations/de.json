{
  "config": {
    "step": {
      "device": {
        "title": "VU+ Bluetooth-Fernbedienung",
        "description": "Wähle das verbundene Linux-Eingabegerät. Falls es fehlt, wecke die Fernbedienung auf und sende das Formular erneut ab, um die Liste zu aktualisieren. Nach dem Löschen des Integrationseintrags kannst du unter Reparaturen entscheiden, ob auch die Bluetooth-Kopplung gelöscht werden soll.",
        "data": {
          "device_name": "Linux-Gerätename",
          "long_press_ms": "Langdruck-Schwelle (ms)"
        }
      },
      "user": {
        "title": "VU+ Bluetooth-Fernbedienung",
        "description": "Wähle, ob die Fernbedienung bereits verbunden ist oder zunächst gekoppelt werden soll.",
        "menu_options": {
          "device": "Bereits verbundenes Eingabegerät auswählen",
          "bluetooth": "Bluetooth-Fernbedienung koppeln"
        }
      },
      "bluetooth": {
        "title": "Bluetooth-Fernbedienung koppeln",
        "description": "Versetze die VU+-Fernbedienung gemäß ihrer Anleitung in den Kopplungsmodus und starte die Suche (etwa 10 Sekunden). Ein eingeschalteter lokaler Bluetooth-Adapter ist erforderlich; Bluetooth-Proxies werden nicht unterstützt. Nach der Auswahl wird die Fernbedienung gekoppelt, dauerhaft als vertrauenswürdig markiert und verbunden. Beim späteren Löschen des Integrationseintrags bleibt die Kopplung erhalten, bis du das zusätzliche Entkoppeln unter Reparaturen ausdrücklich bestätigst."
      },
      "select_remote": {
        "title": "Fernbedienung auswählen",
        "description": "Prüfe Bluetooth-Adresse und Adapter. Mit dem Absenden wird diese Fernbedienung gekoppelt, als vertrauenswürdig markiert und verbunden. Halte sie währenddessen wach. Bestehende Kopplungen werden wiederverwendet. Beim späteren Löschen des Integrationseintrags bleibt die Kopplung erhalten, bis du das zusätzliche Entkoppeln unter Reparaturen ausdrücklich bestätigst.",
        "data": {
          "remote": "VU+-Fernbedienung"
        }
      },
      "device_missing": {
        "title": "Auf Eingabegerät warten",
        "description": "Linux stellt noch kein lesbares Eingabegerät bereit. Wecke die verbundene Fernbedienung auf. Sende dieses Formular ab, um die Geräteliste erneut zu laden. Falls weiterhin kein Gerät erscheint, prüfe den Zugriff von Home Assistant auf /dev/input."
      }
    },
